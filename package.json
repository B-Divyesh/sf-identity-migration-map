{
  "name": "identity-migration-map-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "test": "cargo test && npm run build:site && node --test site/tests/*.test.mjs",
    "build:cli": "cargo build --release",
    "build:site": "vite build --config site/vite.config.ts && node site/build-service-worker.mjs",
    "build": "npm run build:cli && npm run build:site"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
